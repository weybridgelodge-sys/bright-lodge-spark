# ============================================================
# Weybridge Lodge — Apache configuration
# 1) Legacy WordPress -> new route 301 redirects (run FIRST)
# 2) SPA fallback rewrite to index.html (runs LAST)
# ============================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ----------------------------------------------------------
  # 1. Legacy WordPress URLs -> canonical new paths (HTTP 301)
  #    Matching is case-insensitive [NC] and trailing-slash
  #    optional (/?$). R=301,L stops further processing.
  # ----------------------------------------------------------

  # Core pages
  RewriteRule ^guildford-freemasons-what-is-freemasonry/?$ https://weybridgelodge.org.uk/what-is-freemasonry [R=301,L,NC]
  RewriteRule ^frequently-asked-questions-about-freemasonry/?$ https://weybridgelodge.org.uk/what-is-freemasonry [R=301,L,NC]
  RewriteRule ^masonic-lodge-officers-jewels/?$ https://weybridgelodge.org.uk/officers-jewels [R=301,L,NC]
  RewriteRule ^lodge-profile-freemasons-in-guildford-surrey/?$ https://weybridgelodge.org.uk/lodge-profile [R=301,L,NC]
  RewriteRule ^lodge-profile-freemasons-guildford-surrey/?$ https://weybridgelodge.org.uk/lodge-profile [R=301,L,NC]
  RewriteRule ^weybridge-lodge-freemasons-guildford-surrey-lodge-profile/?$ https://weybridgelodge.org.uk/lodge-profile [R=301,L,NC]
  RewriteRule ^history-of-weybridge-lodge-a-freemasons-lodge-in-guildford-surrey/?$ https://weybridgelodge.org.uk/history [R=301,L,NC]
  RewriteRule ^weybridge-lodge-worshipful-master/?$ https://weybridgelodge.org.uk/worshipful-masters [R=301,L,NC]
  RewriteRule ^officers-of-the-lodge-2025-weybridge-lodge/?$ https://weybridgelodge.org.uk/officers [R=301,L,NC]
  RewriteRule ^officers-of-the-lodge-weybridge-lodge-2024/?$ https://weybridgelodge.org.uk/officers [R=301,L,NC]
  RewriteRule ^officers-of-the-lodge-2023-weybridge-lodge/?$ https://weybridgelodge.org.uk/officers [R=301,L,NC]
  RewriteRule ^officers-of-the-lodge-weybridge-lodge/?$ https://weybridgelodge.org.uk/officers [R=301,L,NC]
  RewriteRule ^officers-of-the-lodge-weybridge-lodge-2023-2024/?$ https://weybridgelodge.org.uk/officers [R=301,L,NC]

  # Meetings & events
  RewriteRule ^weybridge-lodge-masonic-meetings-and-social-events/?$ https://weybridgelodge.org.uk/events [R=301,L,NC]
  RewriteRule ^weybridge-lodge-masonic-meetings-social-events/?$ https://weybridgelodge.org.uk/events [R=301,L,NC]
  RewriteRule ^new-years-eve-2025-party/?$ https://weybridgelodge.org.uk/events [R=301,L,NC]
  RewriteRule ^christmas-party-2025/?$ https://weybridgelodge.org.uk/events [R=301,L,NC]
  RewriteRule ^document/summons-373rd-regular-meeting-13122023/?$ https://weybridgelodge.org.uk/events [R=301,L,NC]
  RewriteRule ^document/374th-regular-m/?$ https://weybridgelodge.org.uk/events [R=301,L,NC]
  RewriteRule ^document/374th-regular-meeting/?$ https://weybridgelodge.org.uk/events [R=301,L,NC]
  RewriteRule ^document/committee-meeting-agenda-04012024/?$ https://weybridgelodge.org.uk/events [R=301,L,NC]
  RewriteRule ^document/newsletter-may-2024/?$ https://weybridgelodge.org.uk/heritage [R=301,L,NC]
  RewriteRule ^document/minutes-372nd-regular-meeting-18102023/?$ https://weybridgelodge.org.uk/heritage [R=301,L,NC]
  RewriteRule ^document/committiee-meeting-minutes-sep-2023/?$ https://weybridgelodge.org.uk/heritage [R=301,L,NC]
  RewriteRule ^dining/?$ https://weybridgelodge.org.uk/bookings [R=301,L,NC]

  # Join & contact
  RewriteRule ^surrey-freemasons-join-us/?$ https://weybridgelodge.org.uk/join-us [R=301,L,NC]
  RewriteRule ^contact-weybridge-lodge-freemasons/?$ https://weybridgelodge.org.uk/contact [R=301,L,NC]

  # Charity
  RewriteRule ^guildford-freemasons-charity-surrey/?$ https://weybridgelodge.org.uk/our-charities [R=301,L,NC]
  RewriteRule ^freemasons-charity-weybridge-lodge-raise-31000-for-sands-charity/?$ https://weybridgelodge.org.uk/our-charities [R=301,L,NC]
  RewriteRule ^charity-golf-day-june-2025/?$ https://weybridgelodge.org.uk/our-charities [R=301,L,NC]

  # News & media
  RewriteRule ^post-summary-page/?$ https://weybridgelodge.org.uk/news [R=301,L,NC]
  RewriteRule ^surrey-freemasons-video-hub/?$ https://weybridgelodge.org.uk/video-hub [R=301,L,NC]
  RewriteRule ^75th-anniversary-meeting-february-2024/?$ https://weybridgelodge.org.uk/news/75th-anniversary [R=301,L,NC]

  # Legal & misc
  RewriteRule ^data-protection-policy/?$ https://weybridgelodge.org.uk/data-protection [R=301,L,NC]
  RewriteRule ^masonic-website-links/?$ https://weybridgelodge.org.uk/masonic-links [R=301,L,NC]

  # ----------------------------------------------------------
  # 2. SPA fallback — serve index.html for client-side routes.
  #    Only applies when the request is NOT an existing file
  #    or directory, so real assets keep being served directly.
  # ----------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

# Do not cache index.html so deploys are picked up immediately
<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
