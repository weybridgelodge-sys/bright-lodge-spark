<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications capability. "production" is correct for both
	     TestFlight/App Store builds and (via the APNs sandbox mapping Xcode
	     applies for development signing) local debug builds. -->
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
