# Capacitor generated native config (regenerated by `npx cap sync`)
android/app/capacitor.build.gradle
android/capacitor.settings.gradle

# Capacitor-synced web bundle (regenerated by `npx cap sync android`)
android/app/src/main/assets/public/

# Android build output / signing material — never commit
android/app/release/
weybridge_key_store
*.jks
*.keystore

# NOTE: public/sitemap.xml, image-sitemap.xml, video-sitemap.xml and feed.xml
# are generated by scripts/generate-sitemap-and-feed.ts but are deliberately
# TRACKED - the committed copies are what the deployed site serves. Do not
# gitignore or `git rm --cached` them. Output is deterministic, so a local
# build only shows a diff when the content genuinely changed.

# Generated by `npm run assets:generate` (capacitor-assets, PWA output)
icons/
public/manifest.webmanifest
